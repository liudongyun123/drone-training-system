/* pages/contract-sign/contract-sign.wxss */

.container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 加载状态 */
.loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e0e0e0;
  border-top-color: #2563eb;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  color: #999;
  font-size: 28rpx;
}

/* 错误状态 */
.error-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  padding: 40rpx;
}

.error-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #fee2e2;
  color: #ef4444;
  font-size: 40rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.error-text {
  color: #666;
  font-size: 28rpx;
  margin-bottom: 30rpx;
}

.retry-btn {
  background: #2563eb;
  color: white;
  border-radius: 8rpx;
  padding: 16rpx 60rpx;
  font-size: 28rpx;
}

/* 已签署状态 */
.signed-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60vh;
  padding: 40rpx;
}

.signed-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #dcfce7;
  color: #16a34a;
  font-size: 60rpx;
  font-weight: bold;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}

.signed-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.signed-time {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 60rpx;
}

.back-btn {
  background: #2563eb;
  color: white;
  border-radius: 8rpx;
  padding: 16rpx 80rpx;
  font-size: 30rpx;
}

/* 步骤条 */
.steps {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 40rpx;
  background: white;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e5e7eb;
  color: #999;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
  font-weight: bold;
}

.step.active .step-num {
  background: #2563eb;
  color: white;
}

.step-label {
  font-size: 22rpx;
  color: #999;
}

.step.active .step-label {
  color: #2563eb;
  font-weight: bold;
}

.step-line {
  width: 80rpx;
  height: 2rpx;
  background: #e5e7eb;
  margin: 0 20rpx;
  margin-top: -24rpx;
}

/* 合同内容 */
.contract-section {
  background: white;
  margin: 20rpx;
  border-radius: 12rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 16rpx;
  display: block;
}

.section-subtitle {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: -8rpx;
  margin-bottom: 16rpx;
}

.contract-content {
  height: 400rpx;
  background: #f8fafc;
  border-radius: 8rpx;
  padding: 24rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: #333;
  border: 1rpx solid #e5e7eb;
}

/* 签名区域 */
.signature-section {
  background: white;
  margin: 0 20rpx 20rpx;
  border-radius: 12rpx;
  padding: 24rpx;
}

.signature-pad {
  position: relative;
  border: 2rpx dashed #d1d5db;
  border-radius: 8rpx;
  overflow: hidden;
  background: white;
}

.signature-canvas {
  display: block;
  width: 100%;
  height: 200px;
  background: white;
}

.hint-line {
  position: absolute;
  bottom: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  pointer-events: none;
}

.hint-text {
  color: #ccc;
  font-size: 32rpx;
}

.clear-btn {
  margin-top: 16rpx;
  background: #f3f4f6;
  color: #666;
  border-radius: 8rpx;
  padding: 12rpx 0;
  font-size: 26rpx;
}

/* 同意区域 */
.agree-section {
  background: white;
  margin: 0 20rpx 20rpx;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.agree-row {
  display: flex;
  align-items: center;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 6rpx;
  border: 2rpx solid #d1d5db;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.checkbox.checked {
  background: #2563eb;
  border-color: #2563eb;
}

.check-icon {
  color: white;
  font-size: 24rpx;
  font-weight: bold;
}

.agree-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* 按钮 */
.submit-btn {
  margin: 20rpx 20rpx 0;
  background: #2563eb;
  color: white;
  border-radius: 12rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: bold;
}

.submit-btn.disabled {
  background: #93c5fd;
  color: rgba(255,255,255,0.8);
}

.cancel-btn {
  margin: 16rpx 20rpx 40rpx;
  background: transparent;
  color: #999;
  font-size: 26rpx;
  border: none;
}

.cancel-btn::after {
  border: none;
}

/* ========== 合同列表视图 ========== */
.list-container {
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

.list-header {
  background: white;
  padding: 30rpx 30rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.list-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a1a;
}

.list-count {
  font-size: 26rpx;
  color: #999;
}

.list-scroll {
  padding: 10rpx 20rpx;
}

.contract-card {
  background: white;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.contract-card:active {
  background: #f8fafc;
}

.card-left {
  flex: 1;
  overflow: hidden;
}

.card-course {
  font-size: 30rpx;
  font-weight: 500;
  color: #1a1a1a;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-time {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

.card-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.card-status {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.card-arrow {
  font-size: 36rpx;
  color: #ccc;
}

/* ========== 已签署详情视图 ========== */
.signed-detail {
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

.status-header {
  padding: 40rpx 30rpx;
  text-align: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.status-icon-big {
  font-size: 72rpx;
  display: block;
  margin-bottom: 12rpx;
}

.status-title {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 8rpx;
}

.status-subtitle {
  font-size: 26rpx;
  color: #999;
  display: block;
}

.info-section {
  background: white;
  margin: 20rpx;
  border-radius: 12rpx;
  padding: 24rpx;
}

.info-grid {
  display: flex;
  flex-wrap: wrap;
}

.info-item {
  width: 50%;
  margin-bottom: 20rpx;
}

.info-item:nth-last-child(-n+2) {
  margin-bottom: 0;
}

.info-label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 4rpx;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.contract-content-view {
  height: 500rpx;
  background: #f8fafc;
  border-radius: 8rpx;
  padding: 24rpx;
  font-size: 26rpx;
  line-height: 1.8;
  color: #333;
  border: 1rpx solid #e5e7eb;
  margin-top: 8rpx;
}

.signature-show {
  display: flex;
  justify-content: center;
  padding: 16rpx 0;
}

.signature-img {
  width: 80%;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  background: white;
}

.no-signature {
  color: #999;
  font-size: 26rpx;
}

.seal-show {
  display: flex;
  justify-content: center;
  padding: 16rpx 0;
}

.seal-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
}
