<!--pages/class-detail/class-detail.wxml-->

<view class="page">
  <view wx:if="{{loading}}" class="loading-container">
    <text class="loading-spinner">⏳</text>
    <text class="loading-text">加载中...</text>
  </view>

  <block wx:elif="{{classInfo}}">
    <scroll-view class="content" scroll-y enhanced>
      <!-- 培训班封面 -->
      <view class="cover-section">
        <image 
          class="cover" 
          src="{{classInfo.coverImage || classInfo.cover}}" 
          mode="aspectFill"
          binderror="onCoverError"
        />
      </view>

      <!-- 培训班信息 -->
      <view class="info-section">
        <view class="title-row">
          <text class="level-tag" wx:if="{{classInfo.levelText}}">{{classInfo.levelText}}</text>
          <text class="class-name">{{classInfo.name}}</text>
        </view>
        <view class="price-row">
          <text class="price-symbol">¥</text>
          <text class="price-num">{{classInfo.price || '待定'}}</text>
          <text class="original-price" wx:if="{{classInfo.originalPrice}}">¥{{classInfo.originalPrice}}</text>
          <text class="price-unit">/人</text>
        </view>
        <view class="enroll-row">
          <text class="enroll-count">{{classInfo.enrolledStudents || 0}}/{{classInfo.maxStudents}}人已报名</text>
          <button class="share-btn" open-type="share">
            <text class="share-icon">↗️</text>
            <text class="share-text">分享</text>
          </button>
        </view>
        <view class="status-tag {{classInfo.status}}">
          <text wx:if="{{classInfo.status === 'enrolling'}}">招生中</text>
          <text wx:elif="{{classInfo.status === 'ongoing'}}">进行中</text>
          <text wx:else>已结束</text>
        </view>
      </view>

      <!-- Tab 切换栏 -->
      <view class="tab-bar">
        <view class="tab-item {{activeTab === 'intro' ? 'active' : ''}}" data-tab="intro" bindtap="switchTab">
          <text class="tab-text">培训班介绍</text>
          <view wx:if="{{activeTab === 'intro'}}" class="tab-indicator"></view>
        </view>
        <view class="tab-item {{activeTab === 'schedule' ? 'active' : ''}}" data-tab="schedule" bindtap="switchTab">
          <text class="tab-text">日程安排</text>
          <text class="tab-count">{{schedules.length}}</text>
          <view wx:if="{{activeTab === 'schedule'}}" class="tab-indicator"></view>
        </view>
        <view class="tab-item {{activeTab === 'courses' ? 'active' : ''}}" data-tab="courses" bindtap="switchTab">
          <text class="tab-text">关联课程</text>
          <text class="tab-count">{{includedCourses.length}}</text>
          <view wx:if="{{activeTab === 'courses'}}" class="tab-indicator"></view>
        </view>
      </view>

      <!-- ===== 培训班介绍 Tab ===== -->
      <view wx:if="{{activeTab === 'intro'}}" class="tab-content">
        <view class="section" wx:if="{{classInfo.features && classInfo.features.length > 0}}">
          <text class="section-title">✨ 培训亮点</text>
          <view class="features-list">
            <view class="feature-item" wx:for="{{classInfo.features}}" wx:key="*this">
              <text class="feature-icon">✓</text>
              <text class="feature-text">{{item}}</text>
            </view>
          </view>
        </view>

        <view class="section">
          <text class="section-title">📋 基本信息</text>
          <view class="info-grid">
            <view class="info-item">
              <text class="info-icon">📅</text>
              <text class="info-label">培训时间</text>
              <text class="info-value">{{classInfo.startDate}} - {{classInfo.endDate}}</text>
            </view>
            <view class="info-item">
              <text class="info-icon">📍</text>
              <text class="info-label">培训地点</text>
              <text class="info-value">{{classInfo.location}}</text>
            </view>
            <view class="info-item">
              <text class="info-icon">👨‍🏫</text>
              <text class="info-label">授课讲师</text>
              <text class="info-value">{{classInfo.instructor || '待定'}}</text>
            </view>
            <view class="info-item">
              <text class="info-icon">⏰</text>
              <text class="info-label">上课时间</text>
              <text class="info-value">{{classInfo.schedule || '周一至周五 9:00-17:00'}}</text>
            </view>
          </view>
        </view>

        <view class="section" wx:if="{{classInfo.facilities && classInfo.facilities.length > 0}}">
          <text class="section-title">🏠 设施条件</text>
          <view class="facilities-list">
            <view class="facility-item" wx:for="{{classInfo.facilities}}" wx:key="*this">
              <text class="facility-icon">✓</text>
              <text class="facility-text">{{item}}</text>
            </view>
          </view>
        </view>

        <view class="section">
          <text class="section-title">培训简介</text>
          <text class="description">{{classInfo.description}}</text>
        </view>
      </view>

      <!-- ===== 日程安排 Tab ===== -->
      <view wx:if="{{activeTab === 'schedule'}}" class="tab-content">
        <view class="section">
          <view wx:if="{{schedules.length === 0}}" class="empty-state">
            <text class="empty-icon">📅</text>
            <text class="empty-text">暂无日程安排</text>
          </view>
          <view wx:else class="schedule-list">
            <view class="schedule-item" wx:for="{{schedules}}" wx:key="_id">
              <view class="schedule-left">
                <text class="schedule-day">第{{index + 1}}天</text>
                <text class="schedule-date">{{item.date}}</text>
              </view>
              <view class="schedule-right">
                <text class="schedule-time">{{item.startTime}} - {{item.endTime}}</text>
                <text class="schedule-topic">{{item.topic}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- ===== 关联课程 Tab ===== -->
      <view wx:if="{{activeTab === 'courses'}}" class="tab-content">
        <view class="section">
          <view wx:if="{{includedCourses.length === 0}}" class="empty-state">
            <text class="empty-icon">📚</text>
            <text class="empty-text">暂无关联课程</text>
            <text class="empty-sub">报名后将自动获得课程学习权限</text>
          </view>

          <view wx:else class="courses-list">
            <view 
              wx:for="{{includedCourses}}" 
              wx:key="_id" 
              class="course-card"
              data-id="{{item._id}}"
              bindtap="goToCourse"
            >
              <image class="course-cover" src="{{item.coverImage || item.cover || defaultCover}}" mode="aspectFill" />
              <view class="course-info">
                <text class="course-title">{{item.title}}</text>
                <text class="course-desc">{{item.description || '暂无简介'}}</text>
                <view class="course-meta">
                  <text class="course-lessons">📹 {{item._lessons.length || 0}}节</text>
                  <text wx:if="{{item.price}}" class="course-price">¥{{item.price}}</text>
                  <text wx:else class="course-free">免费</text>
                </view>
              </view>
              <view class="course-arrow">›</view>
            </view>
          </view>

          <!-- 课件资料汇总 -->
          <view wx:if="{{coursewareList.length > 0}}" class="courseware-section">
            <text class="section-title">📄 课件资料 ({{coursewareList.length}})</text>
            <view class="courseware-list">
              <view
                wx:for="{{coursewareList}}"
                wx:key="lessonId"
                class="courseware-card"
                data-fileid="{{item.pdfFile.fileID}}"
                data-name="{{item.pdfFile.name}}"
                bindtap="openPdf"
              >
                <view class="courseware-icon-wrap">
                  <text class="courseware-icon">📄</text>
                </view>
                <view class="courseware-info">
                  <text class="courseware-name">{{item.pdfFile.name || '课程课件'}}</text>
                  <view class="courseware-meta">
                    <text class="courseware-source">来自：{{item.lessonTitle}}</text>
                    <text wx:if="{{item.pdfFile.size}}" class="courseware-size">{{formatFileSize(item.pdfFile.size)}}</text>
                  </view>
                </view>
                <view class="courseware-action">
                  <text wx:if="{{pdfLoading}}" class="courseware-loading">加载中...</text>
                  <view wx:else class="courseware-btn">
                    <text class="courseware-btn-text">查看</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 底部间距 -->
      <view class="footer-space"></view>
    </scroll-view>

    <!-- 底部操作栏 -->
    <view class="bottom-bar safe-area-bottom">
      <view class="action-left">
        <view class="action-item" bindtap="contactService">
          <text class="action-icon">📞</text>
          <text class="action-text">客服</text>
        </view>
      </view>
      <view class="action-right">
        <view 
          class="btn-enroll {{classInfo.status !== 'enrolling' && !isEnrolled ? 'disabled' : ''}}" 
          bindtap="goToEnrollment"
        >
          <text wx:if="{{isEnrolled}}">已报名</text>
          <text wx:elif="{{classInfo.status === 'enrolling'}}">立即报名</text>
          <text wx:else>报名已截止</text>
        </view>
      </view>
    </view>
  </block>
</view>
