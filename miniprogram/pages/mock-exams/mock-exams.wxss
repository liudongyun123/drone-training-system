/* pages/mock-exams/mock-exams.wxss */

.page {
  min-height: 100vh;
  background: #f5f6fa;
  padding-bottom: 32rpx;
}

/* 骨架屏 */
.skeleton-list {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.skeleton-item {
  height: 200rpx;
  background: linear-gradient(90deg, #e0e5ec 25%, #f0f0f0 50%, #e0e5ec 75%);
  background-size: 200% 100%;
  border-radius: 16rpx;
  animation: shimmer 1.5s infinite;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* 考试列表 */
.exam-list {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.exam-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.2s;
}

.exam-card:active {
  transform: scale(0.98);
}

.exam-icon {
  font-size: 52rpx;
  margin-right: 24rpx;
}

.exam-info {
  flex: 1;
}

.exam-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1e40af;
  margin-bottom: 10rpx;
}

.exam-desc {
  display: block;
  font-size: 24rpx;
  color: #3b82f6;
  margin-bottom: 20rpx;
  opacity: 0.7;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.exam-meta {
  display: flex;
  gap: 24rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.meta-icon {
  font-size: 22rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #1e40af;
  opacity: 0.8;
}

.exam-action {
  display: flex;
  align-items: center;
  margin-left: 24rpx;
  padding: 18rpx 28rpx;
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  border-radius: 28rpx;
}

.start-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}

.arrow {
  color: #fff;
  margin-left: 8rpx;
  font-size: 24rpx;
}

/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 64rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #94a3b8;
  text-align: center;
}
