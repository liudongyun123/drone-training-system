<!--pages/mock-exams/mock-exams.wxml-->
<view class="page">
  <!-- 加载状态 -->
  <view wx:if="{{loading && !refreshing}}" class="loading-container">
    <view class="skeleton-list">
      <view class="skeleton-item" wx:for="{{5}}" wx:key="*this"></view>
    </view>
  </view>

  <!-- 考试列表 -->
  <view class="exam-list" wx:if="{{exams.length > 0}}">
    <view 
      class="exam-card"
      wx:for="{{exams}}"
      wx:key="_id"
      bindtap="startExam"
      data-id="{{item._id}}"
      data-title="{{item.title}}"
      data-duration="{{item.duration}}"
    >
      <view class="exam-icon">📋</view>
      <view class="exam-info">
        <text class="exam-title">{{item.title}}</text>
        <text class="exam-desc">{{item.description}}</text>
        <view class="exam-meta">
          <view class="meta-item">
            <text class="meta-icon">⏱</text>
            <text class="meta-text">{{item.duration}}分钟</text>
          </view>
          <view class="meta-item">
            <text class="meta-icon">📝</text>
            <text class="meta-text">{{item.questionCount}}题</text>
          </view>
          <view class="meta-item">
            <text class="meta-icon">✅</text>
            <text class="meta-text">{{item.passScore}}分及格</text>
          </view>
        </view>
      </view>
      <view class="exam-action">
        <text class="start-text">开始</text>
        <text class="arrow">></text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!loading && exams.length === 0}}" class="empty-container">
    <text class="empty-icon">📋</text>
    <text class="empty-title">暂无模拟考试</text>
    <text class="empty-desc">模拟考试正在准备中，敬请期待</text>
  </view>
</view>
