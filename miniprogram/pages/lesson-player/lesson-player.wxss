/* pages/lesson-player/lesson-player.wxss */

.lesson-player {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 128rpx;
}

/* 试看提示横幅 */
.preview-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  border-bottom: 1rpx solid #f59e0b;
}

.preview-banner-text {
  font-size: 24rpx;
  color: #92400e;
  font-weight: 500;
}

.preview-banner-btn {
  padding: 8rpx 20rpx;
  background: #f59e0b;
  border-radius: 20rpx;
}

.preview-banner-btn-text {
  font-size: 22rpx;
  color: #fff;
  font-weight: 500;
}

/* 视频容器 */
.video-container {
  width: 100%;
  background: #000;
  position: relative;
}

/* 视频下载加载层 */
.video-loading-overlay {
  width: 100%;
  height: 422rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0a0a1a;
}

.video-loading-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.video-loading-icon {
  font-size: 56rpx;
  margin-bottom: 8rpx;
}

.video-loading-text {
  font-size: 26rpx;
  color: #aaa;
  margin-bottom: 16rpx;
}

.video-loading-bar {
  width: 400rpx;
  height: 8rpx;
  background: #333;
  border-radius: 4rpx;
  overflow: hidden;
}

.video-loading-fill {
  height: 100%;
  background: linear-gradient(90deg, #2563eb, #3b82f6);
  border-radius: 4rpx;
  transition: width 0.3s;
}

.video-loading-percent {
  font-size: 22rpx;
  color: #888;
  margin-top: 4rpx;
}

.video-player {
  width: 100%;
  height: 422rpx;
}

.video-placeholder {
  width: 100%;
  height: 422rpx;
  background: #1a1a2e;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.placeholder-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.placeholder-text {
  font-size: 32rpx;
  color: #fff;
  margin-bottom: 12rpx;
}

.placeholder-sub {
  font-size: 26rpx;
  color: #999;
}

/* 课时信息 */
.lesson-info {
  padding: 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.lesson-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.lesson-meta {
  display: flex;
  margin-bottom: 16rpx;
}

.meta-item {
  font-size: 26rpx;
  color: #666;
  margin-right: 24rpx;
}

.progress-bar {
  width: 100%;
  height: 8rpx;
  background: #e5e5e5;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #2563eb, #3b82f6);
  border-radius: 4rpx;
  transition: width 0.3s;
}

/* 课时列表 */
.lessons-section {
  flex: 1;
  padding: 24rpx;
  background: #fff;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.lessons-list {
  max-height: 600rpx;
}

.lesson-item {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  background: #f9f9f9;
  transition: all 0.2s;
}

.lesson-item.active {
  background: #eff6ff;
  border: 1rpx solid #2563eb;
}

.lesson-item-order {
  width: 48rpx;
  height: 48rpx;
  background: #94a3b8;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.lesson-item.active .lesson-item-order {
  background: #2563eb;
}

.lesson-item-content {
  flex: 1;
  min-width: 0;
}

.lesson-item-title {
  font-size: 28rpx;
  color: #333;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lesson-item-tags {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  gap: 10rpx;
}

.tag-video {
  font-size: 20rpx;
  color: #2563eb;
  background: #eff6ff;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.tag-pdf {
  font-size: 20rpx;
  color: #d97706;
  background: #fffbeb;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.lesson-item-duration {
  font-size: 24rpx;
  color: #999;
}

.lesson-item-status {
  width: 40rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.status-playing {
  color: #2563eb;
  font-size: 24rpx;
}

/* 底部操作栏 */
.bottom-bar {
  display: flex;
  padding: 24rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
}

.btn-back {
  flex: 1;
  height: 80rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 28rpx;
  border-radius: 40rpx;
  margin-right: 16rpx;
}

.btn-next {
  flex: 1;
  height: 80rpx;
  background: #2563eb;
  color: #fff;
  font-size: 28rpx;
  border-radius: 40rpx;
}

/* 加载状态 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.loading-content {
  display: flex;
  align-items: center;
}

.loading-text {
  font-size: 32rpx;
  color: #666;
}
